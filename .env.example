# ==============================================================================
# OmniGuard AI — Reactive Omni Testnet Deployment & Runtime Configuration
# ==============================================================================
# Copy this file to `.env` and populate DEPLOYER_PRIVATE_KEY (and optional
# NEURAL_SIGNER_PRIVATE_KEY) before running live testnet deployment scripts.
# NEVER commit `.env` with real private keys!

# --- RPC Endpoints (Pre-configured for Reactive Omni Testnets) ---
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
UNICHAIN_SEPOLIA_CHAIN_ID=1301

# --- Verified Reactive Omni System & Callback Proxy Addresses ---
REACTIVE_SYSTEM_CONTRACT=0x8888888888888888888888888888888888888888
BASE_SEPOLIA_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
UNICHAIN_SEPOLIA_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
BASE_SEPOLIA_FAUCET=0x2afaFD298b23b62760711756088F75B7409f5967

# --- Wallet Keys (Testnet ONLY — provide funded Base Sepolia, Unichain Sepolia, and Lasna lREACT) ---
DEPLOYER_PRIVATE_KEY=
# Optional dedicated EIP-712 Neural Sentinel signer (defaults to deployer key if unset)
NEURAL_SIGNER_PRIVATE_KEY=

# --- Funding Amounts for Deployment ---
REACTIVE_CONTRACT_FUND_ETH=0.25
DESTINATION_VAULT_FUND_ETH=0.02
CALLBACK_PROXY_DEPOSIT_ETH=0.02

# --- Deployed Contract Addresses (auto-populated into deployments/testnet.json) ---
BASE_MARKET_FEED_ADDRESS=
UNICHAIN_MARKET_FEED_ADDRESS=
REACTIVE_GUARD_ADDRESS=
BASE_GUARD_VAULT_ADDRESS=
UNICHAIN_GUARD_VAULT_ADDRESS=

# --- AI Agent & Dashboard Backend ---
AGENT_PORT=18788
# Optional LLM key for enhanced natural-language authoring (built-in deterministic compiler + neural MLP always run offline with zero API keys!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
